{
  "name": "نمایشگر KML",
  "short_name": "KML Viewer",
  "description": "باز کردن فایل‌های KML/KMZ و نمایش نقاط روی نقشه با موقعیت زنده",
  "start_url": ".",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#1a73e8",
  "background_color": "#ffffff",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": ".",
      "accept": {
        "application/vnd.google-earth.kml+xml": [".kml"],
        "application/vnd.google-earth.kmz": [".kmz"]
      }
    }
  ]
}